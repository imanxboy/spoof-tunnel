#!/bin/bash
# spoof-tunnel-prepare — ExecStartPre hook for spoof-tunnel.service
#
# Runs before the tunnel process starts:
#   1. Disables rp_filter on the outer interface and TUN (required for spoofed
#      source IPs to pass the kernel's reverse-path filter on ingress).
#   2. Installs an iptables DROP rule so the kernel does not send ICMP
#      port-unreachable replies for spoofed UDP frames that AF_PACKET reads
#      before the networking stack can deliver them to a UDP socket.
#   3. Enables ip_forward for TUN routing between the tunnel and the overlay
#      service (Xray, VLESS, etc.).
#
# Usage: spoof-tunnel-prepare [instance]
#
# The instance name is passed as %i by spoof-tunnel@.service. With no argument
# the flat legacy env file is used, so a pre-multi-tunnel install keeps working.
set -euo pipefail

INSTANCE="${1:-}"
if [ -n "${INSTANCE}" ]; then
    ENV_FILE="/etc/spoof-tunnel/tunnels/${INSTANCE}.env"
else
    ENV_FILE="/etc/spoof-tunnel/tunnel.env"
fi
source "${ENV_FILE}"

# rp_filter must be 0 for spoofed source IPs to survive the kernel's ingress
# check. Without this, inbound spoofed packets are silently dropped before
# AF_PACKET sees them on the RX path.
sysctl -qw "net.ipv4.conf.${IFACE}.rp_filter=0"    2>/dev/null || true
sysctl -qw "net.ipv4.conf.${TUN_NAME}.rp_filter=0" 2>/dev/null || true
sysctl -qw "net.ipv4.conf.all.rp_filter=0"         2>/dev/null || true

# Drop incoming tunnel UDP so the kernel does not send ICMP port-unreachable
# replies. AF_PACKET intercepts the raw frame before the kernel processes it,
# but without this rule the kernel also tries to deliver the packet to a UDP
# socket, fails, and generates unwanted ICMP traffic back to the peer.
#
# Scoped to the outer physical interface. Tunnel frames only ever arrive
# there, and an unscoped rule also matches the TUN device: when a forwarded
# port equals the tunnel's own listen port, the unscoped form drops the UDP
# traffic the tunnel just delivered through tun0 to the overlay service.
if [ "${OUTER:-udp}" = "udp" ]; then
    if ! iptables -C INPUT -i "${IFACE}" -p udp \
            --dport "${LISTEN_PORT}" -j DROP 2>/dev/null; then
        iptables -I INPUT -i "${IFACE}" -p udp --dport "${LISTEN_PORT}" -j DROP
    fi
    # Remove the unscoped rule left by earlier versions, which would keep
    # swallowing tunnel-delivered traffic on the same port number.
    while iptables -C INPUT -p udp --dport "${LISTEN_PORT}" -j DROP 2>/dev/null; do
        iptables -D INPUT -p udp --dport "${LISTEN_PORT}" -j DROP
        echo "spoof-tunnel-prepare: removed unscoped INPUT DROP for udp/${LISTEN_PORT}"
    done
fi

# ip_forward is required for the TUN interface to forward packets between the
# tunnel and the overlay service.
sysctl -qw net.ipv4.ip_forward=1
